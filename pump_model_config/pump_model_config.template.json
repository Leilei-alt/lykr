{
  "version": "3.0",
  "description": "Runtime configuration for database-driven pump curve regression. Device grouping is read from database group_id fields.",
  "defaults": {
    "flow_unit": "m3/h",
    "head_unit": "m",
    "power_unit": "kW",
    "efficiency_factor": 0.00275,
    "speed_ratio_tolerance": 0.02,
    "valid_filters": {
      "min_flow": 0,
      "min_head": 0,
      "min_power": 0,
      "min_speed_ratio": 0.2,
      "max_speed_ratio": 1.2,
      "min_efficiency": 0,
      "max_efficiency": 1
    }
  }
}
